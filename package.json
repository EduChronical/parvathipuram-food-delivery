{
  "name": "parvathipuram-bites-phase2-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm --prefix frontend ci && npm --prefix frontend run build",
