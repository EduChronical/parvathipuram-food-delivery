{
  "name": "parvathipuram-bites",
  "version": "3.0.0",
  "private": true,
  "engines": { "node": ">=22 <23" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "db:generate": "npm run generate -w @ppm/database",
    "db:migrate": "npm run migrate:deploy -w @ppm/database",
    "db:seed": "npm run seed -w @ppm/database",
    "build": "npm run db:generate && npm run build -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present",
    "test": "npm run test -ws --if-present",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": { "typescript": "^5.7.3" }
}