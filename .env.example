# PPM Bites environment template
# Replace example-placeholder-* values only when the corresponding provider is ready.
# The application treats these placeholders as NOT configured.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/parvathipuram_bites

# Core security
JWT_SECRET=example-placeholder-jwt-secret-replace-with-32-plus-random-characters
REFRESH_TOKEN_SECRET=example-placeholder-refresh-secret-replace-with-32-plus-random-characters
APP_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
NEXT_PUBLIC_API_URL=http://localhost:4000
LOG_LEVEL=info

# Redis / Upstash
REDIS_URL=example-placeholder-upstash-redis-url

# Razorpay
PAYMENT_PROVIDER=dev
PAYMENT_API_KEY=example-placeholder-razorpay-key-id
PAYMENT_API_SECRET=example-placeholder-razorpay-key-secret
PAYMENT_WEBHOOK_SECRET=example-placeholder-razorpay-webhook-secret
NEXT_PUBLIC_PAYMENT_PROVIDER=dev

# Twilio SMS
SMS_PROVIDER=dev
SMS_API_KEY=example-placeholder-twilio-account-sid
SMS_API_SECRET=example-placeholder-twilio-auth-token
SMS_FROM=example-placeholder-twilio-sender-number

# Resend email
EMAIL_PROVIDER=dev
EMAIL_API_KEY=example-placeholder-resend-api-key
EMAIL_FROM=example-placeholder-verified-sender@example.com

# Maps: set MAP_PROVIDER=google or mapbox after replacing the key
MAP_PROVIDER=none
MAP_API_KEY=example-placeholder-google-maps-or-mapbox-key

# Cloudflare R2 / S3-compatible object storage
STORAGE_ENDPOINT=example-placeholder-r2-s3-endpoint
STORAGE_REGION=auto
STORAGE_BUCKET=example-placeholder-r2-bucket
STORAGE_ACCESS_KEY=example-placeholder-r2-access-key-id
STORAGE_SECRET_KEY=example-placeholder-r2-secret-access-key
STORAGE_PUBLIC_URL=example-placeholder-r2-public-url

# Firebase Cloud Messaging server credentials
FCM_PROJECT_ID=example-placeholder-firebase-project-id
FCM_CLIENT_EMAIL=example-placeholder-firebase-service-account-email
FCM_PRIVATE_KEY=example-placeholder-firebase-private-key

# Firebase Web App public configuration (customer PWA build-time variables)
NEXT_PUBLIC_FIREBASE_API_KEY=example-placeholder-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-placeholder-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-placeholder-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-placeholder-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=example-placeholder-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=example-placeholder-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=example-placeholder-firebase-web-push-vapid-public-key

# Bootstrap/demo
ADMIN_EMAIL=example-placeholder-admin@example.com
ADMIN_INITIAL_PASSWORD=example-placeholder-admin-password
DEMO_PASSWORD=DemoPass!2026
DEV_OTP_CODE=123456

# Business/runtime defaults
DELIVERY_FEE_PAISE=2500
RIDER_OFFER_TTL_MINUTES=2
