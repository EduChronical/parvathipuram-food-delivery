NODE_ENV=production
PORT=8080
DATABASE_URL=postgres://app_runtime:CHANGE_ME@127.0.0.1:5432/parvathipuram_bites
DB_POOL_MAX=20

# JWTs accepted from the application auth layer. HS256 only in this Phase-2 backend.
JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=parvathipuram-bites
JWT_AUDIENCE=parvathipuram-bites-api

# Existing Phase-1 active app_users row with role=super_admin.
# Used as the database-side service actor for transactional writes that invoke
# Phase-1 RLS/audit/status-event triggers. External actors are independently
# authorized by the service layer before every write.
SYSTEM_ACTOR_USER_ID=00000000-0000-0000-0000-000000000000

PAYMENT_WEBHOOK_SECRET=replace-with-random-webhook-secret
# Comma-separated provider ids accepted by the payment-events webhook. Empty disables provider events.
PAYMENT_ALLOWED_PROVIDERS=

# Exact public frontend origin(s) only when the UI is served from another host.
# On Render, same-origin deployment uses RENDER_EXTERNAL_URL automatically.
CORS_ALLOWED_ORIGINS=
SMS_PROVIDER_URL=https://sms-provider.example/send
SMS_PROVIDER_API_KEY=replace-me
SMS_SENDER_ID=PVBITES

RIDER_OFFER_TTL_SECONDS=30
RIDER_ONLINE_GRACE_SECONDS=90
ASSIGNMENT_POLL_MS=3000
UNASSIGNED_POLL_MS=10000
NOTIFICATION_POLL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_LEASE_SECONDS=60
WORKER_BATCH_SIZE=50
