# PPM Bites production template
# Safe to commit: all secrets are placeholders. Replace them only in your secret manager / Railway variables.
NODE_ENV=production
PORT=4000

DATABASE_URL=example-placeholder-production-postgresql-url
REDIS_URL=example-placeholder-upstash-redis-url
JWT_SECRET=example-placeholder-production-jwt-secret-32-plus-random-characters
REFRESH_TOKEN_SECRET=example-placeholder-production-refresh-secret-32-plus-random-characters

APP_ORIGIN=https://example-placeholder-customer-domain,https://example-placeholder-restaurant-domain,https://example-placeholder-delivery-domain,https://example-placeholder-admin-domain
NEXT_PUBLIC_API_URL=https://example-placeholder-api-domain

PAYMENT_PROVIDER=razorpay
PAYMENT_API_KEY=example-placeholder-razorpay-live-key-id
PAYMENT_API_SECRET=example-placeholder-razorpay-live-key-secret
PAYMENT_WEBHOOK_SECRET=example-placeholder-razorpay-webhook-secret
NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay

SMS_PROVIDER=twilio
SMS_API_KEY=example-placeholder-twilio-account-sid
SMS_API_SECRET=example-placeholder-twilio-auth-token
SMS_FROM=example-placeholder-twilio-sender

EMAIL_PROVIDER=resend
EMAIL_API_KEY=example-placeholder-resend-api-key
EMAIL_FROM=example-placeholder-verified-sender@example.com

MAP_PROVIDER=google
MAP_API_KEY=example-placeholder-google-maps-api-key

STORAGE_ENDPOINT=example-placeholder-cloudflare-r2-s3-endpoint
STORAGE_REGION=auto
STORAGE_BUCKET=example-placeholder-cloudflare-r2-bucket
STORAGE_ACCESS_KEY=example-placeholder-cloudflare-r2-access-key-id
STORAGE_SECRET_KEY=example-placeholder-cloudflare-r2-secret-access-key
STORAGE_PUBLIC_URL=example-placeholder-cloudflare-r2-public-url

FCM_PROJECT_ID=example-placeholder-firebase-project-id
FCM_CLIENT_EMAIL=example-placeholder-firebase-service-account-email
FCM_PRIVATE_KEY=example-placeholder-firebase-private-key

NEXT_PUBLIC_FIREBASE_API_KEY=example-placeholder-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-placeholder-firebase-auth-domain
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-placeholder-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-placeholder-firebase-storage-bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=example-placeholder-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=example-placeholder-firebase-web-app-id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=example-placeholder-firebase-web-push-vapid-public-key

ADMIN_EMAIL=example-placeholder-admin@example.com
ADMIN_INITIAL_PASSWORD=example-placeholder-strong-admin-password
DEMO_PASSWORD=example-placeholder-disable-or-use-qa-only
DEV_OTP_CODE=example-placeholder-do-not-use-in-production

DELIVERY_FEE_PAISE=2500
RIDER_OFFER_TTL_MINUTES=2
LOG_LEVEL=info
